{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.vidmark.dev/schemas/question-bank.schema.json",
  "title": "Vidmark CCA-F Question Bank",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bankId",
    "title",
    "updatedAt",
    "disclaimer",
    "domains",
    "sections",
    "questions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "bankId": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weight"],
        "properties": {
          "id": { "enum": ["architecture", "tools", "code", "prompting", "context"] },
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "videoStartSeconds"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "videoStartSeconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "rationale"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "sectionId",
        "domainId",
        "difficulty",
        "mode",
        "scenario",
        "question",
        "options",
        "correctAnswer",
        "grading",
        "videoReferences",
        "sources",
        "tags"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "enabled": { "type": "boolean" },
        "sectionId": { "$ref": "#/$defs/slug" },
        "domainId": { "enum": ["architecture", "tools", "code", "prompting", "context"] },
        "difficulty": { "enum": ["foundational", "standard", "advanced"] },
        "mode": { "enum": ["standard", "hard"] },
        "scenario": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "D"],
          "properties": {
            "A": { "$ref": "#/$defs/option" },
            "B": { "$ref": "#/$defs/option" },
            "C": { "$ref": "#/$defs/option" },
            "D": { "$ref": "#/$defs/option" }
          }
        },
        "correctAnswer": { "enum": ["A", "B", "C", "D"] },
        "grading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temptingDistractor", "principle", "missType", "hinge"],
          "properties": {
            "temptingDistractor": { "enum": ["A", "B", "C", "D"] },
            "principle": { "type": "string", "minLength": 1 },
            "missType": { "enum": ["judgment", "recall"] },
            "hinge": { "type": "string", "minLength": 1 }
          }
        },
        "videoReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timestampSeconds", "label"],
            "properties": {
              "timestampSeconds": { "type": "integer", "minimum": 0 },
              "label": { "type": "string", "minLength": 1 },
              "screenshot": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url", "accessedAt"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "accessedAt": { "type": "string", "format": "date" }
            }
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    }
  }
}
