{$VIDMARK_RELAY_HOST} {
	handle_path /updates/* {
		root * /srv/updates
		file_server
		header Cache-Control "public, max-age=300"
	}

	handle {
		reverse_proxy relay:31800
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
