{
  "name": "vidmark",
  "version": "1.3.3",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:native": "zsh scripts/test-native-authentication.sh",
    "dev": ".tools/bun/bin/bun scripts/local-dev.mjs",
    "build:transcriber": "zsh scripts/build-native-transcriber.sh",
    "notes:transcribe": ".tools/bun/bin/bun scripts/transcription-server.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log .tools/bun/bin/bun node_modules/vinext/dist/cli.js build",
    "package:mac": "zsh scripts/build-macos-app.sh",
    "package:dmg": "zsh scripts/build-macos-dmg.sh",
    "release:mac": "zsh scripts/publish-macos-update.sh",
    "package:dxt": "zsh scripts/build-dxt.sh",
    "relay:start": "zsh scripts/relay-apple-container.sh start",
    "relay:stop": "zsh scripts/relay-apple-container.sh stop",
    "relay:status": "zsh scripts/relay-apple-container.sh status",
    "relay:verify": "VIDMARK_RELAY_URL=ws://127.0.0.1:31800/ws .tools/bun/bin/bun scripts/verify-relay-sync.ts",
    "relay:verify:production": "VIDMARK_RELAY_URL=wss://vidmark-159-223-136-163.sslip.io/ws .tools/bun/bin/bun scripts/verify-relay-sync.ts",
    "agent:verify": ".tools/bun/bin/bun scripts/verify-agent-workflow.ts",
    "dxt:verify": ".tools/bun/bin/bun scripts/verify-dxt.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log .tools/bun/bin/bun node_modules/vinext/dist/cli.js start",
    "test": "pnpm run build && .tools/bun/bin/bun test tests/rendered-html.test.mjs tests/concept-graph.test.ts tests/question-sharing.test.ts tests/system-prompts.test.ts tests/transcript-acquisition.test.ts",
    "lint": ".tools/bun/bin/bun node_modules/eslint/bin/eslint.js . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@dicebear/bottts": "9.4.2",
    "@dicebear/core": "^9.4.2",
    "@dicebear/lorelei": "9.4.2",
    "@dicebear/notionists": "9.4.2",
    "@dicebear/thumbs": "9.4.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.32.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bun": "^1.4.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
